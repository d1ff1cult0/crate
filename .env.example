# Copy to .env and fill in. Never commit .env.

POSTGRES_PASSWORD=change-me

# 32 random bytes, base64. Generate: openssl rand -base64 32
# LOSING THIS MEANS RE-ENTERING EVERY STORED CREDENTIAL. Back it up.
CRATE_ENCRYPTION_KEY=

# Generate: openssl rand -base64 32
CRATE_SESSION_SECRET=

# Where the app is reachable. Must match the Spotify app's redirect URI origin.
PUBLIC_URL=http://localhost:3000
WEB_PORT=3000

# HOST paths. These are what the host sees — the container sees /music, /staging, /trash.
# Navidrome may see something different again: that is what pathMappings in Settings is for.
MUSIC_ROOT=./data/music
STAGING_ROOT=./data/staging
TRASH_ROOT=./data/trash

# Local dev only (compose sets these itself)
DATABASE_URL=postgresql://crate:change-me@localhost:5432/crate
REDIS_URL=redis://localhost:6379
# Disabled by default. Set a long random server-only value to enable the protected
# YouTube import API; the operator enters the same value in the UI per browser session.
CRATE_YOUTUBE_IMPORT_TOKEN=
ACOUSTID_API_KEY=

# Spotify app. The client ID is public by design in a PKCE flow, so it is not a secret.
# NO CLIENT SECRET IS NEEDED — Authorization Code + PKCE does not use one.
SPOTIFY_CLIENT_ID=
# Must match the redirect URI registered in the Spotify dashboard EXACTLY.
SPOTIFY_REDIRECT_URI=https://spotdl.jplessers.com/callback
