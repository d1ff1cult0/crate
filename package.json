{
  "name": "crate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @crate/web dev",
    "dev:worker": "pnpm --filter @crate/worker dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @crate/core --filter @crate/integrations --filter @crate/providers test",
    "test:core": "pnpm --filter @crate/core test",
    "test:watch": "pnpm --filter @crate/core test:watch",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @crate/db generate",
    "db:migrate": "pnpm --filter @crate/db migrate",
    "db:deploy": "pnpm --filter @crate/db deploy",
    "db:studio": "pnpm --filter @crate/db studio"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7"
  }
}
